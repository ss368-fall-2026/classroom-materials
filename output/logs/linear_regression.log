. *--------------------------------------
. * SAMPLING VARIANCE VISUALS
. *--------------------------------------
. 
. local num_samples = 10000

. 
. foreach sample_size in 1000 5000 {
  2.         
.                 set seed 403
  3.                 
.                 matrix beta1_est_`num_samples' = J(`num_samples', 1, .)
  4.                 
.                 use `raw_data', clear 
  5.                 
.                 forvalues i = 1/`num_samples' { 
  6.                         preserve 
  7.                                 
.                                 *** draw a random sample without replacement 
.                                 qui sample `sample_size', count
  8.                                 
.                                 qui reg body_wt ln_earnings 
  9.                                 
.                                 matrix beta1_est_`num_samples'[`i', 1] = _b[ln_earnings] 
 10.                         
.                         restore 
 11.                 }
 12.         
.                 * convert matrix to dta
.                 clear 
 13.                 qui svmat beta1_est_`num_samples', names(beta)
 14. 
.                 qui sum beta1
 15.                 local e_beta1 = `r(mean)'
 16. 
.                 * plot histogram
.                 local f_e_beta1 = string(round(`e_beta1',.001), "%09.3fc")
 17.                 local f_pop_beta = string(round(`pop_beta',.001), "%09.3fc")
 18.                 local f_sample_size = string(`sample_size', "%9.0fc")
 19.                 local f_num_samples = string(`num_samples', "%9.0fc")
 20.                 twoway histogram beta1, density color(gs8) gap(10) ||, title("Distribution of Estimates Across Samples") subtitle("N = `f_sample_size', Samples = `f_num_samples'") ylabel(, angle(0)) xtitle("Beta Estimates") ytitle("Density") legen
> d(off) graphregion(color(white)) caption("Population Beta: `f_pop_beta'" "Avg. Beta Across Samples: `f_e_beta1'")
 21.                 qui graph export "${output}/figures/sampling_variation_ex_`num_samples'_samples_size_`sample_size'.svg", width(1600) fontface("Times New Roman") replace
 22. }

